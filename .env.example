# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# Public HTTPS URL of the Mini App (tunnel in dev, e.g. https://xxx.trycloudflare.com)
WEBAPP_URL=https://example.trycloudflare.com

# LLM (any OpenAI-compatible endpoint: OpenAI, DashScope/Qwen, z.ai/GLM)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-6-sol
# Only needed for reasoning models that reject function tools otherwise
# (error mentions "reasoning_effort"). Leave unset for most models.
# LLM_REASONING_EFFORT=none
# Small model that decides which agent handles a message, and answers the
# cheap lanes (factual lookups, small talk). Defaults to LLM_MODEL.
# LLM_ROUTER_MODEL=gpt-6-luna
# Multimodal model for photos the athlete sends (a workout on a whiteboard, a
# screenshot, a watch display). Defaults to LLM_MODEL.
# LLM_VISION_MODEL=gpt-6-sol

# Auth
JWT_SECRET=change-me-long-random

# Postgres (compose default user/db = coach)
POSTGRES_PASSWORD=coach

# Timezone fallback when a user has no location timezone set.
# Used for daily check-in hour matching (default push hour is 7am local).
TZ=Europe/Berlin

# Local dev only: lets the webapp log in without Telegram via /api/auth/dev-session.
# Must be false/unset outside local development.
DEV_MODE=false

# Production only (docker-compose.prod.yml / Caddy): the domain Caddy gets an
# HTTPS certificate for. Should match the host in WEBAPP_URL above.
# DOMAIN=coach.example.com
